{
  "name": "session-watchtower",
  "displayName": "Session Watchtower for Claude Code",
  "description": "%description%",
  "version": "0.24.1",
  "scripts": {
    "test": "node --test test/*.test.js",
    "shot": "bash tools/screenshot/run.sh"
  },
  "publisher": "kms-labs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:claudeSessionChanges.sessions",
    "onView:claudeSessionChanges.tree",
    "onView:claudeSessionChanges.mcp",
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSessionChanges",
          "title": "Session Watchtower",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeSessionChanges": [
        {
          "id": "claudeSessionChanges.sessions",
          "name": "%view.sessions%",
          "icon": "media/icon.svg",
          "type": "webview"
        },
        {
          "id": "claudeSessionChanges.tree",
          "name": "%view.changes%",
          "icon": "media/icon.svg"
        },
        {
          "id": "claudeSessionChanges.mcp",
          "name": "%view.mcp%",
          "icon": "media/icon.svg",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSessionChanges.refresh",
        "title": "%command.refresh%",
        "category": "Session Watchtower",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessionChanges.showAliveOnly",
        "title": "%command.showAliveOnly%",
        "category": "Session Watchtower",
        "icon": "$(filter)"
      },
      {
        "command": "claudeSessionChanges.showAll",
        "title": "%command.showAll%",
        "category": "Session Watchtower",
        "icon": "$(filter-filled)"
      },
      {
        "command": "claudeSessionChanges.pickWindow",
        "title": "%command.pickWindow%",
        "category": "Session Watchtower",
        "icon": "$(history)"
      },
      {
        "command": "claudeSessionChanges.pickArchiveAfter",
        "title": "%command.pickArchiveAfter%",
        "category": "Session Watchtower",
        "icon": "$(archive)"
      },
      {
        "command": "claudeSessionChanges.openSettings",
        "title": "%command.openSettings%",
        "category": "Session Watchtower"
      },
      {
        "command": "claudeSessionChanges.openFileDiff",
        "title": "%command.openFileDiff%"
      },
      {
        "command": "claudeSessionChanges.openChangeDiff",
        "title": "%command.openChangeDiff%"
      },
      {
        "command": "claudeSessionChanges.openFile",
        "title": "%command.openFile%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeSessionChanges.copyPath",
        "title": "%command.copyPath%"
      },
      {
        "command": "claudeSessionChanges.copySessionId",
        "title": "%command.copySessionId%"
      },
      {
        "command": "claudeSessionChanges.revealSession",
        "title": "%command.revealSession%",
        "icon": "$(list-tree)"
      },
      {
        "command": "claudeSessionChanges.openClaudeSession",
        "title": "%command.openClaudeSession%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeSessionChanges.openSessionChanges",
        "title": "%command.openSessionChanges%",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeSessionChanges.archiveSession",
        "title": "%command.archiveSession%",
        "icon": "$(archive)"
      },
      {
        "command": "claudeSessionChanges.searchConversations",
        "title": "%command.searchConversations%",
        "category": "Session Watchtower",
        "icon": "$(search)"
      },
      {
        "command": "claudeSessionChanges.copySummary",
        "title": "%command.copySummary%",
        "category": "Session Watchtower"
      },
      {
        "command": "claudeSessionChanges.copyFolderSummary",
        "title": "%command.copyFolderSummary%",
        "category": "Session Watchtower",
        "icon": "$(clippy)"
      },
      {
        "command": "claudeSessionChanges.sessionsForFile",
        "title": "%command.sessionsForFile%"
      },
      {
        "command": "claudeSessionChanges.resetOverlapIgnore",
        "title": "%command.resetOverlapIgnore%",
        "category": "Session Watchtower"
      },
      {
        "command": "claudeSessionChanges.renameSession",
        "title": "%command.renameSession%",
        "category": "Session Watchtower",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSessionChanges.createGroup",
        "title": "%command.createGroup%",
        "category": "Session Watchtower",
        "icon": "$(add)"
      },
      {
        "command": "claudeSessionChanges.openGroupBoard",
        "title": "%command.openGroupBoard%",
        "category": "Session Watchtower",
        "icon": "$(layout)"
      },
      {
        "command": "claudeSessionChanges.renameGroup",
        "title": "%command.renameGroup%",
        "category": "Session Watchtower"
      },
      {
        "command": "claudeSessionChanges.deleteGroup",
        "title": "%command.deleteGroup%",
        "category": "Session Watchtower"
      },
      {
        "command": "claudeSessionChanges.addToGroup",
        "title": "%command.addToGroup%"
      },
      {
        "command": "claudeSessionChanges.removeFromGroup",
        "title": "%command.removeFromGroup%"
      },
      {
        "command": "claudeSessionChanges.setSessionRole",
        "title": "%command.setSessionRole%"
      },
      {
        "command": "claudeSessionChanges.planTeam",
        "title": "%command.planTeam%",
        "category": "Session Watchtower",
        "icon": "$(lightbulb)"
      },
      {
        "command": "claudeSessionChanges.checkMcp",
        "title": "%command.checkMcp%",
        "category": "Session Watchtower",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeSessionChanges.openFileDiff",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.openChangeDiff",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.openFile",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.copyPath",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.copySessionId",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.revealSession",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.openClaudeSession",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.openSessionChanges",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.archiveSession",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.copySummary",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.renameSession",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.addToGroup",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.removeFromGroup",
          "when": "false"
        },
        {
          "command": "claudeSessionChanges.setSessionRole",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "claudeSessionChanges.showAliveOnly",
          "when": "view == claudeSessionChanges.tree && !claudeSessionChanges.aliveOnly",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessionChanges.showAll",
          "when": "view == claudeSessionChanges.tree && claudeSessionChanges.aliveOnly",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessionChanges.pickWindow",
          "when": "view == claudeSessionChanges.tree",
          "group": "navigation@2"
        },
        {
          "command": "claudeSessionChanges.refresh",
          "when": "view == claudeSessionChanges.tree",
          "group": "navigation@3"
        },
        {
          "command": "claudeSessionChanges.openSettings",
          "when": "view == claudeSessionChanges.tree",
          "group": "z_settings"
        },
        {
          "command": "claudeSessionChanges.refresh",
          "when": "view == claudeSessionChanges.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessionChanges.pickArchiveAfter",
          "when": "view == claudeSessionChanges.sessions",
          "group": "z_settings"
        },
        {
          "command": "claudeSessionChanges.searchConversations",
          "when": "view == claudeSessionChanges.sessions",
          "group": "1_search"
        },
        {
          "command": "claudeSessionChanges.copyFolderSummary",
          "when": "view == claudeSessionChanges.tree",
          "group": "2_copy"
        },
        {
          "command": "claudeSessionChanges.createGroup",
          "when": "view == claudeSessionChanges.sessions",
          "group": "0_groups@1"
        },
        {
          "command": "claudeSessionChanges.openGroupBoard",
          "when": "view == claudeSessionChanges.sessions",
          "group": "0_groups@2"
        },
        {
          "command": "claudeSessionChanges.planTeam",
          "when": "view == claudeSessionChanges.sessions",
          "group": "0_groups@0"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSessionChanges.openFile",
          "when": "view == claudeSessionChanges.tree && viewItem == file",
          "group": "inline"
        },
        {
          "command": "claudeSessionChanges.openFile",
          "when": "view == claudeSessionChanges.tree && viewItem == file",
          "group": "1_open@1"
        },
        {
          "command": "claudeSessionChanges.openFileDiff",
          "when": "view == claudeSessionChanges.tree && viewItem == file",
          "group": "1_open@2"
        },
        {
          "command": "claudeSessionChanges.copyPath",
          "when": "view == claudeSessionChanges.tree && viewItem == file",
          "group": "2_copy@1"
        },
        {
          "command": "claudeSessionChanges.copySessionId",
          "when": "view == claudeSessionChanges.tree && viewItem =~ /^session/",
          "group": "2_copy@1"
        },
        {
          "command": "claudeSessionChanges.openSessionChanges",
          "when": "view == claudeSessionChanges.tree && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "claudeSessionChanges.openClaudeSession",
          "when": "view == claudeSessionChanges.tree && viewItem =~ /^session/",
          "group": "inline@2"
        },
        {
          "command": "claudeSessionChanges.openSessionChanges",
          "when": "view == claudeSessionChanges.tree && viewItem == session",
          "group": "1_open@0"
        },
        {
          "command": "claudeSessionChanges.openClaudeSession",
          "when": "view == claudeSessionChanges.tree && viewItem =~ /^session/",
          "group": "1_open@1"
        },
        {
          "command": "claudeSessionChanges.archiveSession",
          "when": "view == claudeSessionChanges.tree && viewItem =~ /^session/",
          "group": "inline@3"
        },
        {
          "command": "claudeSessionChanges.archiveSession",
          "when": "view == claudeSessionChanges.tree && viewItem =~ /^session/",
          "group": "3_archive@1"
        },
        {
          "command": "claudeSessionChanges.copySummary",
          "when": "view == claudeSessionChanges.tree && viewItem == session",
          "group": "2_copy@2"
        },
        {
          "command": "claudeSessionChanges.renameSession",
          "when": "view == claudeSessionChanges.tree && viewItem =~ /^session/",
          "group": "3_archive@0"
        },
        {
          "command": "claudeSessionChanges.addToGroup",
          "when": "view == claudeSessionChanges.tree && viewItem =~ /^session/",
          "group": "3_archive@2"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeSessionChanges.sessionsForFile",
          "when": "!explorerResourceIsFolder",
          "group": "z_sessionwatchtower"
        }
      ],
      "editor/title/context": [
        {
          "command": "claudeSessionChanges.sessionsForFile",
          "group": "z_sessionwatchtower"
        }
      ]
    },
    "configuration": {
      "title": "Session Watchtower",
      "properties": {
        "claudeSessionChanges.lookbackHours": {
          "type": "number",
          "default": 24,
          "minimum": 0.1,
          "maximum": 720,
          "description": "%config.lookbackHours%"
        },
        "claudeSessionChanges.showShellGuesses": {
          "type": "boolean",
          "default": true,
          "description": "%config.showShellGuesses%"
        },
        "claudeSessionChanges.hideScratchpadFiles": {
          "type": "boolean",
          "default": true,
          "description": "%config.hideScratchpadFiles%"
        },
        "claudeSessionChanges.includeSubagents": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeSubagents%"
        },
        "claudeSessionChanges.pollSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "%config.pollSeconds%"
        },
        "claudeSessionChanges.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar%"
        },
        "claudeSessionChanges.notifyWaiting": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyWaiting%"
        },
        "claudeSessionChanges.notifyOverlap": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyOverlap%"
        },
        "claudeSessionChanges.overlapIgnore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.claude/projects/*/memory/**"
          ],
          "description": "%config.overlapIgnore%"
        },
        "claudeSessionChanges.notifyStuckMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 240,
          "description": "%config.notifyStuckMinutes%"
        },
        "claudeSessionChanges.explorerMarks": {
          "type": "boolean",
          "default": true,
          "description": "%config.explorerMarks%"
        },
        "claudeSessionChanges.sessionDetails": {
          "type": "boolean",
          "default": true,
          "description": "%config.sessionDetails%"
        },
        "claudeSessionChanges.sessionListDays": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 365,
          "description": "%config.sessionListDays%"
        },
        "claudeSessionChanges.archiveAfter": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude",
            "1",
            "2",
            "3",
            "7",
            "14",
            "30",
            "never"
          ],
          "enumItemLabels": [
            "%config.archiveAfter.claude%",
            "%config.archiveAfter.d1%",
            "%config.archiveAfter.d2%",
            "%config.archiveAfter.d3%",
            "%config.archiveAfter.d7%",
            "%config.archiveAfter.d14%",
            "%config.archiveAfter.d30%",
            "%config.archiveAfter.never%"
          ],
          "description": "%config.archiveAfter%"
        },
        "claudeSessionChanges.includeCodex": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeCodex%"
        },
        "claudeSessionChanges.attentionMarkerDir": {
          "type": "string",
          "default": "~/.cache/claude-attention",
          "description": "%config.attentionMarkerDir%"
        },
        "claudeSessionChanges.boardPageSize": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 200,
          "description": "%config.boardPageSize%"
        }
      }
    }
  },
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#172A46",
    "theme": "dark"
  },
  "keywords": [
    "claude",
    "claude code",
    "session",
    "changed files",
    "diff",
    "status",
    "agent",
    "codex",
    "openai codex"
  ],
  "files": [
    "extension.js",
    "scanner.js",
    "worker.js",
    "mcp.js",
    "media/icon.svg",
    "media/logo.png",
    "l10n/**",
    "package.nls.json",
    "package.nls.ko.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "l10n": "./l10n",
  "author": {
    "name": "KMS Labs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/myoungsuk/session-watchtower.git"
  },
  "bugs": {
    "url": "https://github.com/myoungsuk/session-watchtower/issues"
  },
  "homepage": "https://github.com/myoungsuk/session-watchtower#readme"
}
